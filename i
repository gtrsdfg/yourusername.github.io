body {
    background-color: #121212;
    color: white;
    font-family: Arial, sans-serif;
    text-align: center;
}

h1 {
    margin-top: 20px;
}

#gameList {
    margin: 20px;
}

.game-btn {
    background: #1e90ff;
    border: none;
    padding: 10px 15px;
    margin: 5px;
    color: white;
    cursor: pointer;
    border-radius: 8px;
}

.game-btn:hover {
    background: #0f70cc;
}

#gameContainer {
    width: 90%;
    height: 500px;
    margin: 20px auto;
    border: 2px solid #444;
}

#gameFrame {
    width: 100%;
    height: 100%;
}
